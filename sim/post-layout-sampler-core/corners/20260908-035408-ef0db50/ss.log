|* POST-LAYOUT WHOLE CELL
|* ==========================================================================
|
|* --- per-ring periods, 10 whole periods each, first two rising edges
|* discarded as start-up (identical estimator to
|* sim/post-layout-ro-array-core/) ----------------------------------------
|meas tran pt1a when v(xarr.ro1)=0.5*1.8 rise=3
|meas tran pt1b when v(xarr.ro1)=0.5*1.8 rise=13
|let p_tr1 = (pt1b - pt1a)/10
|meas tran pt2a when v(xarr.ro2)=0.5*1.8 rise=3
|meas tran pt2b when v(xarr.ro2)=0.5*1.8 rise=13
|let p_tr2 = (pt2b - pt2a)/10
|meas tran pt3a when v(xarr.ro3)=0.5*1.8 rise=3
|meas tran pt3b when v(xarr.ro3)=0.5*1.8 rise=13
|let p_tr3 = (pt3b - pt3a)/10
|meas tran pt4a when v(xarr.ro4)=0.5*1.8 rise=3
|meas tran pt4b when v(xarr.ro4)=0.5*1.8 rise=13
|let p_tr4 = (pt4b - pt4a)/10
|let p_f_ideal = 1/p_tr1 + 1/p_tr2 + 1/p_tr3 + 1/p_tr4
|
|* --- combining node (N=4, xo): swing, realized edge rate, value bias, now
|* under the six-sampler bank's own real capacitive loading + clk-dependent
|* switching -----------------------------------------------------------
|meas tran pvxo_max MAX v(xarr.xo) from=100n to=800n
|meas tran pvxo_min MIN v(xarr.xo) from=100n to=800n
|let p_swing_frac_xo = (pvxo_max - pvxo_min) / 1.8
|meas tran ptxo_a when v(xarr.xo)=0.5*1.8 rise=2
|meas tran ptxo_b when v(xarr.xo)=0.5*1.8 rise=50
|let p_f_xo = 48/(ptxo_b - ptxo_a)
|let p_edge_retention = p_f_xo / p_f_ideal
|meas tran pvxo_avg AVG v(xarr.xo) from=100n to=800n
|let p_bias_xo = pvxo_avg / 1.8
|
|* --- reset-held check: all six sampler outputs must stay near 0 while
|* rst_n is still asserted (0-300n), regardless of the rings' own toggling
|* -------------------------------------------------------------------
|meas tran p_vrst_bit MAX v(praw_bit) from=50n to=250n
|meas tran p_vrst_valid MAX v(praw_valid) from=50n to=250n
|meas tran p_vrst_r1 MAX v(pring_bit1) from=50n to=250n
|meas tran p_vrst_r2 MAX v(pring_bit2) from=50n to=250n
|meas tran p_vrst_r3 MAX v(pring_bit3) from=50n to=250n
|meas tran p_vrst_r4 MAX v(pring_bit4) from=50n to=250n
