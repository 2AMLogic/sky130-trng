|meas tran t1a when v(xctl.ro1)=0.5*1.98 rise=3
|meas tran t1b when v(xctl.ro1)=0.5*1.98 rise=13
|let tr1 = (t1b - t1a)/10
|meas tran t2a when v(xctl.ro2)=0.5*1.98 rise=3
|meas tran t2b when v(xctl.ro2)=0.5*1.98 rise=13
|let tr2 = (t2b - t2a)/10
|meas tran t3a when v(xctl.ro3)=0.5*1.98 rise=3
|meas tran t3b when v(xctl.ro3)=0.5*1.98 rise=13
|let tr3 = (t3b - t3a)/10
|meas tran t4a when v(xctl.ro4)=0.5*1.98 rise=3
|meas tran t4b when v(xctl.ro4)=0.5*1.98 rise=13
|let tr4 = (t4b - t4a)/10
|let f_ideal = 1/tr1 + 1/tr2 + 1/tr3 + 1/tr4
