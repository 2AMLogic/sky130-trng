|meas tran r2_400n find v(ring_bit2) at=400n
|meas tran r3_400n find v(ring_bit3) at=400n
|meas tran r4_400n find v(ring_bit4) at=400n
|
|meas tran i1_rst AVG i(Vddr1) from=50n to=250n
|meas tran i2_rst AVG i(Vddr2) from=50n to=250n
|meas tran i3_rst AVG i(Vddr3) from=50n to=250n
|meas tran i4_rst AVG i(Vddr4) from=50n to=250n
|meas tran ib_rst AVG i(Vdd) from=50n to=250n
|let i_rings_rst = -(i1_rst + i2_rst + i3_rst + i4_rst)
|let i_block_rst = -ib_rst
|let i_total_rst = i_rings_rst + i_block_rst
|
|meas tran i1_act AVG i(Vddr1) from=400n to=800n
|meas tran i2_act AVG i(Vddr2) from=400n to=800n
|meas tran i3_act AVG i(Vddr3) from=400n to=800n
|meas tran i4_act AVG i(Vddr4) from=400n to=800n
|meas tran ib_act AVG i(Vdd) from=400n to=800n
