|meas tran vxo_max MAX v(xctl.xo) from=100n to=800n
|meas tran vxo_min MIN v(xctl.xo) from=100n to=800n
|let swing_frac_xo = (vxo_max - vxo_min) / 1.62
|meas tran txo_a when v(xctl.xo)=0.5*1.62 rise=2
|meas tran txo_b when v(xctl.xo)=0.5*1.62 rise=50
|let f_xo = 48/(txo_b - txo_a)
