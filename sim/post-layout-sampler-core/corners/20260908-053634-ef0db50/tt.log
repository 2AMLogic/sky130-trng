|.temp 125.0
|
|* --- substrate return node: hard tie (see header) ----------------------
|Vsub vsubs 0 dc 0
|
|* --- post-layout WHOLE CELL, one flat-extracted circuit ----------------
|Vddrp1 pvddr1 0 dc 1.98
|Vddrp2 pvddr2 0 dc 1.98
|Vddrp3 pvddr3 0 dc 1.98
|Vddrp4 pvddr4 0 dc 1.98
|Vddp pvdd 0 dc 1.98
|Venp1 pen1 0 PULSE(0 1.98 5n 100p 100p 1u 2u)
|Venp2 pen2 0 PULSE(0 1.98 5n 100p 100p 1u 2u)
|Venp3 pen3 0 PULSE(0 1.98 5n 100p 100p 1u 2u)
|Venp4 pen4 0 PULSE(0 1.98 5n 100p 100p 1u 2u)
|Vrstnp prst_n 0 PULSE(0 1.98 300n 100p 100p 10u 20u)
|Vclkp pclk 0 PULSE(0 1.98 320n 100p 100p 49.8n 100n)
|xarr pen1 pen2 pen3 pen4 pvddr1 pvddr2 pvddr3 pvddr4 pvdd 0 pclk prst_n
|+ praw_bit praw_valid pring_bit1 pring_bit2 pring_bit3 pring_bit4
|+ sampler_core_pex
|
|* --- pre-layout control, identical topology, single-call subckt --------
|Vddr1 vddr1 0 dc 1.98
|Vddr2 vddr2 0 dc 1.98
|Vddr3 vddr3 0 dc 1.98
|Vddr4 vddr4 0 dc 1.98
|Vdd vdd 0 dc 1.98
|Ven1 en1 0 PULSE(0 1.98 5n 100p 100p 1u 2u)
|Ven2 en2 0 PULSE(0 1.98 5n 100p 100p 1u 2u)
|Ven3 en3 0 PULSE(0 1.98 5n 100p 100p 1u 2u)
|Ven4 en4 0 PULSE(0 1.98 5n 100p 100p 1u 2u)
|Vrstn rst_n 0 PULSE(0 1.98 300n 100p 100p 10u 20u)
|Vclk clk 0 PULSE(0 1.98 320n 100p 100p 49.8n 100n)
|xctl en1 en2 en3 en4 vddr1 vddr2 vddr3 vddr4 vdd 0 clk rst_n
|+ raw_bit raw_valid ring_bit1 ring_bit2 ring_bit3 ring_bit4
|+ sampler_core
|
|.ic v(xarr.ro1)=0 v(xarr.ro2)=0 v(xarr.ro3)=0 v(xarr.ro4)=0
|.ic v(xctl.ro1)=0 v(xctl.ro2)=0 v(xctl.ro3)=0 v(xctl.ro4)=0
|
|* Limit the saved transient trace set to exactly what the .meas statements
|* below need (see header -- this is a hard memory requirement here, not an
|* optimization).
|.save v(xarr.ro1) v(xarr.ro2) v(xarr.ro3) v(xarr.ro4) v(xarr.xo)
|.save v(xctl.ro1) v(xctl.ro2) v(xctl.ro3) v(xctl.ro4) v(xctl.xo)
|.save v(praw_bit) v(praw_valid) v(pring_bit1) v(pring_bit2) v(pring_bit3) v(pring_bit4)
|.save v(raw_bit) v(raw_valid) v(ring_bit1) v(ring_bit2) v(ring_bit3) v(ring_bit4)
|.save i(Vddrp1) i(Vddrp2) i(Vddrp3) i(Vddrp4) i(Vddp)
|.save i(Vddr1) i(Vddr2) i(Vddr3) i(Vddr4) i(Vdd)
