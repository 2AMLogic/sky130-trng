    {
      "name": "tk21",
      "spice": ".meas tran tk21 when v(ro)=0.99 rise=21"
    },
    {
      "name": "tk22",
      "spice": ".meas tran tk22 when v(ro)=0.99 rise=22"
    },
    {
      "name": "dvn_rb",
      "spice": ".meas tran dvn_rb find v(vth_dvn) at=1n"
    },
    {
      "name": "dvp_rb",
      "spice": ".meas tran dvp_rb find v(vth_dvp) at=1n"
