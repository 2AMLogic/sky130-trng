# sim/ harness: per-corner ngspice logs under corners/ are committed evidence
# (append-only record trail), so they escape the *.log rule.
!sim/*/corners/**/*.log
sim/build/
# ngspice's BSIM4 model-parameter checker dumps this next to the process's
# cwd on every run that elaborates a BSIM4 card -- scratch, never evidence.
bsim4v5.out
# machine-local PDK override for design/netlist.py (design/pdk.json is committed)
design/pdk.local.json
sim/pdk.local.json
# xschem scratch left next to a schematic when it is opened interactively
design/xschem/*.sch.bak
design/xschem/*.sym.bak
# synthesis / P&R scratch
flow/build/
# local klt install, created by the setup script
.venv/
