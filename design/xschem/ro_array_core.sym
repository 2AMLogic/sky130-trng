v {xschem version=3.4.4 file_version=1.2}
G {}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
description="The sky130-trng entropy source: four separately-supplied 5-stage starved rings on a skewed wstv ladder, combined through a balanced depth-2 XOR tree into xo. N = 4 and the 5-stage count are MEASURED sky130 choices fixed by spec/decision-records/DR-0003-sky130-trng-operating-point (Proposed), which supersedes the refuted N = 2 x 11 placeholder -- see ro_array_core.sch for the two bounds (entropy lower bound N >= 4 at T_s = 20 us, XOR-combining upper bound N <= 6, measured at DIFFERENT corners) that pin it. Pin order MUST track design/xschem/ro_array_core.sch's own .subckt signature exactly: en1..en4 vddr1..vddr4 vdd vss xo ro1..ro4 -- see design/ro_array_core.spice. ro1..ro4 are OBSERVATION-ONLY outputs so a per-ring liveness digitizer in sampler_core.sch can reach every ring; they add no device and change no ring, and a parent that leaves them unconnected gets exactly the array without them. They are not a raw tap and never leave the die."
}
V {}
S {}
E {}
B 5 -102.5 -77.5 -97.5 -72.5 {name=en1 dir=in}
B 5 -102.5 -27.5 -97.5 -22.5 {name=en2 dir=in}
B 5 -102.5 22.5 -97.5 27.5 {name=en3 dir=in}
B 5 -102.5 72.5 -97.5 77.5 {name=en4 dir=in}
B 5 -77.5 -102.5 -72.5 -97.5 {name=vddr1 dir=inout}
B 5 -27.5 -102.5 -22.5 -97.5 {name=vddr2 dir=inout}
B 5 22.5 -102.5 27.5 -97.5 {name=vddr3 dir=inout}
B 5 72.5 -102.5 77.5 -97.5 {name=vddr4 dir=inout}
B 5 -52.5 97.5 -47.5 102.5 {name=vdd dir=inout}
B 5 47.5 97.5 52.5 102.5 {name=vss dir=inout}
B 5 97.5 -2.5 102.5 2.5 {name=xo dir=out}
B 5 97.5 -77.5 102.5 -72.5 {name=ro1 dir=out}
B 5 97.5 -27.5 102.5 -22.5 {name=ro2 dir=out}
B 5 97.5 22.5 102.5 27.5 {name=ro3 dir=out}
B 5 97.5 72.5 102.5 77.5 {name=ro4 dir=out}
